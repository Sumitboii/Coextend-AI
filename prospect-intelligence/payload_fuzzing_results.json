  "3_null_vs_omitted_vs_empty": {
    "cases": [
      {
        "description": "company_name explicitly null",
        "request_body": {
          "company_name": null,
          "website": "https://example.com"
        },
        "status_code": 422,
        "response_body": {
          "detail": [
            {
              "type": "string_type",
              "loc": [
                "body",
                "company_name"
              ],
              "msg": "Input should be a valid string",
              "input": null
            }
          ]
        }
      },
      {
        "description": "company_name omitted entirely",
        "request_body": {
          "website": "https://example.com"
        },
        "status_code": 422,
        "response_body": {
          "detail": [
            {
              "type": "missing",
              "loc": [
                "body",
                "company_name"
              ],
              "msg": "Field required",
              "input": {
                "website": "https://example.com"
              }
            }
          ]
        }
      },
      {
        "description": "company_name empty string",
        "request_body": {
          "company_name": "",
          "website": "https://example.com"
        },
        "status_code": 422,
        "response_body": {
          "detail": [
            {
              "type": "string_too_short",
              "loc": [
                "body",
                "company_name"
              ],
              "msg": "String should have at least 1 character",
              "input": "",
              "ctx": {
                "min_length": 1
              }
            }
          ]
        }
      },
      {
        "description": "website explicitly null",
        "request_body": {
          "company_name": "Acme",
          "website": null
        },
        "status_code": 422,
        "response_body": {
          "detail": [
            {
              "type": "url_type",
              "loc": [
                "body",
                "website"
              ],
              "msg": "URL input should be a string or URL",
              "input": null
            }
          ]
        }
      }
    ]
  },
