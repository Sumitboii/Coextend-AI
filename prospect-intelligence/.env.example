# ============================================================
# Coextend Prospect Intelligence MVP — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM (Google Gemini - free tier at aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=models/gemini-2.0-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_DIMENSION=3072
PINECONE_METRIC=cosine

Google_API-KEY=AIzaSyCXP8A9Z1FsUYjHajpNc1v-BT1c4DFdhUc 

# --- Web Search (Tavily - free tier at tavily.com) ---
TAVILY_API_KEY=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

# --- Storage ---
# SQLite path (relative to project root, or absolute)
DATABASE_URL=sqlite:///./data/prospect_intelligence.db

# Vector store path (Chroma persists to disk at this directory)
VECTOR_STORE_PATH=./data/vector_store

# Knowledge base PDF directory
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# CRM export output directory
EXPORTS_PATH=./data/exports

# Sample CRM dataset (for duplicate detection)
CRM_SAMPLE_PATH=./data/crm_sample/sample_crm.json

# --- Job settings ---
# Hours before a same-company resubmit triggers a duplicate warning
DUPLICATE_COOLDOWN_HOURS=24

# --- Retry / backoff ---
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.5

# --- Logging ---
LOG_LEVEL=INFO
